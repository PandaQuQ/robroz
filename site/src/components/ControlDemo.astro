---
import type { Messages } from '../i18n';
import Gloss from './Gloss.astro';

interface Props {
  msg: Messages;
}

const { msg } = Astro.props;
const { demo } = msg.control;
const bro = msg.hero.demo.bro;
const heroStatus = msg.hero.demo.status;
const waitingGloss = demo.statusGloss;
const approvalGloss = [demo.approvalGloss, demo.approveGloss && demo.denyGloss ? `${demo.approveGloss} / ${demo.denyGloss}` : '']
  .filter(Boolean)
  .join(' · ');
---

<figure
  class="control-demo"
  data-demo="control"
  data-waiting-label={demo.status}
  data-waiting-gloss={waitingGloss}
  data-queued-label={heroStatus.queued}
  data-queued-gloss={heroStatus.queuedGloss}
  data-running-label={heroStatus.running}
  data-running-gloss={heroStatus.running1Gloss}
  data-done-label={heroStatus.done}
  data-done-gloss={heroStatus.doneGloss}
  data-answered-gloss={demo.answeredGloss}
  data-approval-gloss={approvalGloss}
>
  <div class="demo-item control-status-item">
    <article class="status-card" data-state="queued" aria-live="polite">
      <p class="status-card__line">
        <strong>{bro}</strong>
        <span aria-hidden="true"> · </span>
        <span class="status-card__label">{demo.status}</span>
      </p>
    </article>
    {waitingGloss ? <p class="gloss control-status-gloss">{waitingGloss}</p> : null}
  </div>

  <div class="demo-item control-approval-item" hidden>
    <article class="approval-card">
      <p>{demo.approval}</p>
      <div class="approval-card__actions">
        <span class="approval-btn approval-btn--yes">{demo.approve}</span>
        <span class="approval-btn">{demo.deny}</span>
      </div>
      <p class="approval-card__foot" hidden>{demo.answered}</p>
    </article>
    {approvalGloss ? <p class="gloss control-approval-gloss">{approvalGloss}</p> : null}
  </div>
</figure>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Step = 'waiting' | 'approval' | 'answered' | 'queued' | 'running' | 'done';
  const steps: Step[] = ['waiting', 'approval', 'answered', 'queued', 'running', 'done'];

  for (const root of document.querySelectorAll<HTMLElement>('.control-demo')) {
    const card = root.querySelector<HTMLElement>('.status-card');
    const label = root.querySelector<HTMLElement>('.status-card__label');
    const statusGloss = root.querySelector<HTMLElement>('.control-status-gloss');
    const approvalItem = root.querySelector<HTMLElement>('.control-approval-item');
    const actions = root.querySelector<HTMLElement>('.approval-card__actions');
    const foot = root.querySelector<HTMLElement>('.approval-card__foot');
    const approvalGloss = root.querySelector<HTMLElement>('.control-approval-gloss');
    if (!card || !label || !approvalItem || !actions || !foot) continue;

    const apply = (step: Step) => {
      const statusStep = step === 'waiting' ? 'waiting' : step === 'approval' || step === 'answered' ? 'waiting' : step;
      const state = statusStep === 'waiting' || statusStep === 'queued' ? 'queued' : statusStep;
      card.dataset.state = state;
      const labelKey = `${statusStep}Label`;
      const text = root.dataset[labelKey];
      if (text) label.textContent = text;
      const glossKey = `${statusStep}Gloss`;
      const glossText = root.dataset[glossKey] ?? '';
      if (statusGloss) {
        statusGloss.hidden = !glossText;
        statusGloss.textContent = glossText;
      }

      const showApproval = step === 'approval' || step === 'answered' || step === 'queued' || step === 'running' || step === 'done';
      approvalItem.hidden = !showApproval;
      approvalItem.classList.toggle('is-visible', showApproval);

      const answered = step === 'answered' || step === 'queued' || step === 'running' || step === 'done';
      actions.hidden = answered;
      foot.hidden = !answered;
      if (approvalGloss) {
        const g = answered ? (root.dataset.answeredGloss ?? '') : (root.dataset.approvalGloss ?? '');
        approvalGloss.hidden = !g;
        approvalGloss.textContent = g;
      }
    };

    if (reduceMotion) {
      apply('done');
      continue;
    }

    let index = 0;
    apply(steps[index]);
    const timer = window.setInterval(() => {
      index = (index + 1) % steps.length;
      apply(steps[index]);
    }, 2000);

    root.addEventListener('demo-step', ((event: Event) => {
      const step = (event as CustomEvent).detail as Step;
      if (!steps.includes(step)) return;
      window.clearInterval(timer);
      index = steps.indexOf(step);
      apply(step);
    }) as EventListener);
  }
</script>
