---
import { t } from '../i18n';
import ChatDemo from './ChatDemo.astro';
import ControlDemo from './ControlDemo.astro';
import RichText from './RichText.astro';

const msg = t(Astro.currentLocale);
---

<section class="section" id="hero">
  <h1>{msg.hero.title}</h1>
  <p class="lede">{msg.hero.lede}</p>
  <p class="cta-row">
    <a class="btn-primary" href="#quickstart">{msg.hero.cta.primary}</a>
    <a class="btn-secondary" href={msg.links.github.url}>{msg.hero.cta.secondary}</a>
  </p>
  <ChatDemo msg={msg} />
</section>

<section class="section" id="features">
  <h2>{msg.features.title}</h2>
  <div class="grid grid--3">
    <article class="card">
      <h3>{msg.features.tasks.title}</h3>
      <p><RichText text={msg.features.tasks.body} /></p>
    </article>
    <article class="card">
      <h3>{msg.features.memory.title}</h3>
      <p><RichText text={msg.features.memory.body} /></p>
    </article>
    <article class="card">
      <h3>{msg.features.skills.title}</h3>
      <p><RichText text={msg.features.skills.body} /></p>
    </article>
  </div>
</section>

<section class="section" id="control">
  <h2>{msg.control.title}</h2>
  <p class="lede">{msg.control.lede}</p>
  <div class="grid grid--2">
    <article class="card">
      <h3>{msg.control.tiers.title}</h3>
      <p><RichText text={msg.control.tiers.body} /></p>
    </article>
    <article class="card">
      <h3>{msg.control.approval.title}</h3>
      <p><RichText text={msg.control.approval.body} /></p>
    </article>
    <article class="card">
      <h3>{msg.control.takeover.title}</h3>
      <p><RichText text={msg.control.takeover.body} /></p>
    </article>
    <article class="card">
      <p><RichText text={msg.control.sandbox.body} /></p>
    </article>
  </div>
  <ControlDemo msg={msg} />
</section>

<section class="section quickstart" id="quickstart">
  <h2>{msg.quickstart.title}</h2>
  <p class="lede">{msg.quickstart.lede}</p>
  <pre><code>{msg.quickstart.code}</code></pre>
  <p><RichText text={msg.quickstart.next} /></p>
  <p>
    <RichText text={msg.quickstart.more} />
    {' '}
    <a href={msg.quickstart.moreLink.href}>{msg.quickstart.moreLink.label}</a>
  </p>
  <p>{msg.quickstart.platforms}</p>
</section>

<section class="section" id="links">
  <h2>{msg.links.title}</h2>
  <ul class="link-cards">
    <li class="card">
      <h3><a href={msg.links.github.url}>{msg.links.github.label}</a></h3>
      <p>{msg.links.github.body}</p>
    </li>
    <li class="card">
      <h3><a href={msg.links.wiki.url}>{msg.links.wiki.label}</a></h3>
      <p>{msg.links.wiki.body}</p>
    </li>
    <li class="card">
      <h3><a href={msg.links.agents.url}>{msg.links.agents.label}</a></h3>
      <p>{msg.links.agents.body}</p>
    </li>
  </ul>
</section>
