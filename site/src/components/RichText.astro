---
interface Props {
  text: string;
}

const { text } = Astro.props;
const parts = text.split(/(\*[^*]+\*|`[^`]+`)/g);
---

{
  parts.map((part) => {
    if (part.startsWith('*') && part.endsWith('*') && part.length > 2) {
      return <em>{part.slice(1, -1)}</em>;
    }
    if (part.startsWith('`') && part.endsWith('`') && part.length > 2) {
      return <code>{part.slice(1, -1)}</code>;
    }
    return part;
  })
}
