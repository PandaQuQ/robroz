---
import type { Messages } from '../i18n';
import Gloss from './Gloss.astro';

interface Props {
  msg: Messages;
}

const { msg } = Astro.props;
const { demo } = msg.hero;
---

<figure class="chat" data-demo="hero">
  <div class="demo-item demo-item--you">
    <article class="bubble bubble--you">
      <span class="bubble__who">{demo.you}</span>
      <p>{demo.user}</p>
    </article>
    <Gloss text={demo.userGloss} />
  </div>

  <div
    class="demo-item status-demo"
    data-queued-label={demo.status.queued}
    data-queued-gloss={demo.status.queuedGloss}
    data-running-label={demo.status.running}
    data-running1-progress={demo.status.running1Progress}
    data-running1-gloss={demo.status.running1Gloss}
    data-running2-progress={demo.status.running2Progress}
    data-running2-gloss={demo.status.running2Gloss}
    data-done-label={demo.status.done}
    data-done-gloss={demo.status.doneGloss}
  >
    <article class="status-card" data-state="queued" aria-live="polite">
      <p class="status-card__line">
        <strong>{demo.bro}</strong>
        <span aria-hidden="true"> · </span>
        <span class="status-card__label">{demo.status.queued}</span>
      </p>
      <p class="status-card__progress" hidden></p>
    </article>
    {demo.status.queuedGloss ? (
      <p class="gloss status-card-gloss">{demo.status.queuedGloss}</p>
    ) : null}
  </div>

  <div class="demo-item delivery-item" hidden>
    <article class="delivery-card">
      <p>{demo.delivery}</p>
      <p class="delivery-card__path"><code>{demo.deliveryPath}</code></p>
    </article>
    <Gloss text={demo.deliveryGloss} />
  </div>

  <figcaption class="chat__caption">{demo.caption}</figcaption>
</figure>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Step = 'queued' | 'running1' | 'running2' | 'done';
  const steps: Step[] = ['queued', 'running1', 'running2', 'done'];

  for (const item of document.querySelectorAll<HTMLElement>('.status-demo')) {
    const root = item.closest<HTMLElement>('.chat');
    const card = item.querySelector<HTMLElement>('.status-card');
    const label = item.querySelector<HTMLElement>('.status-card__label');
    const progress = item.querySelector<HTMLElement>('.status-card__progress');
    const gloss = item.querySelector<HTMLElement>('.status-card-gloss');
    const delivery = root?.querySelector<HTMLElement>('.delivery-item');
    if (!card || !label || !progress) continue;

    const apply = (step: Step) => {
      const running = step === 'running1' || step === 'running2';
      card.dataset.state = running ? 'running' : step;
      const labelKey = running ? 'runningLabel' : `${step}Label`;
      const text = item.dataset[labelKey];
      if (text) label.textContent = text;

      const progressText = running
        ? step === 'running1'
          ? item.dataset.running1Progress
          : item.dataset.running2Progress
        : '';
      if (progressText) {
        progress.hidden = false;
        progress.textContent = progressText;
      } else {
        progress.hidden = true;
        progress.textContent = '';
      }

      const glossKey =
        step === 'running1'
          ? 'running1Gloss'
          : step === 'running2'
            ? 'running2Gloss'
            : `${step}Gloss`;
      const glossText = item.dataset[glossKey] ?? '';
      if (gloss) {
        gloss.hidden = !glossText;
        gloss.textContent = glossText;
      }

      if (delivery) {
        const show = step === 'done';
        delivery.hidden = !show;
        delivery.classList.toggle('is-visible', show);
      }
    };

    if (reduceMotion) {
      apply('done');
      continue;
    }

    let index = 0;
    apply(steps[index]);
    const timer = window.setInterval(() => {
      index = (index + 1) % steps.length;
      apply(steps[index]);
    }, 2000);

    root?.addEventListener('demo-step', ((event: Event) => {
      const step = (event as CustomEvent).detail as Step;
      if (!steps.includes(step)) return;
      window.clearInterval(timer);
      index = steps.indexOf(step);
      apply(step);
    }) as EventListener);
  }
</script>
