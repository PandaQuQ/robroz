---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import '../styles/global.css';

const msg = t(Astro.currentLocale);
const home = getRelativeLocaleUrl(msg.locale, '/');
const enHref = getRelativeLocaleUrl('en', '/');
const zhHref = getRelativeLocaleUrl('zh', '/');
---

<!doctype html>
<html lang={msg.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={msg.description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="zh" href={new URL(zhHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enHref, Astro.site)} />
    <title>{msg.title}</title>
  </head>
  <body>
    <a class="skip" href="#content">{msg.skipToContent}</a>
    <header class="site-header wrap">
      <a href={home}>
        <img class="wordmark" src={`${import.meta.env.BASE_URL}wordmark.svg`} alt={msg.title} width="120" height="24" />
      </a>
      <nav class="lang-switch" aria-label={msg.lang.switchLabel}>
        <a href={enHref} aria-current={msg.locale === 'en' ? 'page' : undefined}>{msg.lang.en}</a>
        <span aria-hidden="true">/</span>
        <a href={zhHref} aria-current={msg.locale === 'zh' ? 'page' : undefined}>{msg.lang.zh}</a>
      </nav>
    </header>
    <main id="content" class="wrap">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>{msg.footer}</p>
    </footer>
  </body>
</html>
