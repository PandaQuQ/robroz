---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import '../styles/global.css';

const msg = t(Astro.currentLocale);
const base = import.meta.env.BASE_URL;
const home = getRelativeLocaleUrl(msg.locale, '/');
const enHref = getRelativeLocaleUrl('en', '/');
const zhHref = getRelativeLocaleUrl('zh', '/');
---

<!doctype html>
<html lang={msg.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={msg.meta.description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="zh" href={new URL(zhHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enHref, Astro.site)} />
    <title>{msg.meta.title}</title>
  </head>
  <body>
    <a class="skip" href="#content">{msg.a11y.skip}</a>
    <header class="site-header wrap">
      <a class="wordmark-link" href={home}>
        <!-- Page is always paper, so only the light wordmark is used. -->
        <img
          class="wordmark"
          src={`${base}wordmark-light.svg`}
          alt="robroz"
          width="160"
          height="32"
        />
      </a>
      <div class="header-tools">
        <a href={msg.links.github.url}>{msg.nav.github}</a>
        <a href={msg.links.wiki.url}>{msg.nav.wiki}</a>
        <nav class="lang-switch" aria-label={msg.a11y.langSwitch}>
          <a href={enHref} aria-current={msg.locale === 'en' ? 'page' : undefined}>{msg.nav.lang.en}</a>
          <span aria-hidden="true">/</span>
          <a href={zhHref} aria-current={msg.locale === 'zh' ? 'page' : undefined}>{msg.nav.lang.zh}</a>
        </nav>
      </div>
    </header>
    <main id="content" class="wrap">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>{msg.footer.license}</p>
      <p><a href={msg.links.github.url}>{msg.footer.repo}</a></p>
    </footer>
  </body>
</html>
